# Copy to `.env` (which is gitignored) and fill in locally. NEVER commit real values.
# Castellan reads config from ~/.castellan/config.toml; these env vars override for local dev.

# Provider profiles are managed by `clavis` — reference profiles by name, not raw keys.
CASTELLAN_BRAIN_PROFILE=your-clavis-profile
CASTELLAN_CLAVIS_PROFILE=your-clavis-profile

# Optional add-ons (off by default)
# CASTELLAN_TELEGRAM_TOKEN=<from-botfather>
# CASTELLAN_WEB_ADDR=127.0.0.1:8080
