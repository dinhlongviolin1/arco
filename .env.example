# Copy to `.env` (which is gitignored) and fill in locally. NEVER commit real values.
# Arco reads config from ~/.arco/config.toml; ARCO_* env vars override for local dev.
# Full list: internal/config/config.go (the Getenv block in Load).

# Provider profiles are managed by `clavis` — reference profiles by name, not raw keys.
ARCO_BRAIN_PROFILE=your-clavis-profile
ARCO_CLAVIS_PROFILE=your-clavis-profile

# The intake HMAC master secret (required whenever tcp_addr is set).
# ARCO_INTAKE_SECRET=<random-256-bit-hex>
