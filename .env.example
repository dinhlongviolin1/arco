# Copy to `.env` (which is gitignored) and fill in locally. NEVER commit real values.
# Arco reads config from ~/.arco/config.toml; these env vars override for local dev.

# Provider profiles are managed by `clavis` — reference profiles by name, not raw keys.
ARCO_BRAIN_PROFILE=your-clavis-profile
ARCO_CLAVIS_PROFILE=your-clavis-profile

# Optional add-ons (off by default)
# ARCO_TELEGRAM_TOKEN=<from-botfather>
# ARCO_WEB_ADDR=127.0.0.1:8080
